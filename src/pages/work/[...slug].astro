---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.sortDate.localeCompare(a.data.sortDate));

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const facts = [
  { label: 'Role', value: d.role },
  { label: 'Organization', value: d.company },
  { label: 'Client', value: d.client },
  { label: 'Industry', value: d.industry },
  { label: 'Period', value: d.period },
  ...(d.teamSize ? [{ label: 'Scope', value: d.teamSize }] : []),
];
---

<Base title={d.title} description={d.summary}>
  <article>
    <header class="page hero">
      <p class="eyebrow">{d.company} · {d.period}</p>
      <h1>{d.title}</h1>
      <p class="hero-tagline">{d.tagline}</p>
    </header>

    {
      d.metrics.length > 0 && (
        <section class="page metrics" aria-label="Key outcomes">
          {d.metrics.map((m) => (
            <div class="metric">
              <p class="metric-value">{m.value}</p>
              <p class="metric-label">{m.label}</p>
            </div>
          ))}
        </section>
      )
    }

    <div class="page body-grid">
      <aside class="facts" aria-label="Project details">
        <dl>
          {
            facts.map((f) => (
              <div class="fact">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          d.skills.length > 0 && (
            <div class="fact fact-skills">
              <p class="fact-heading">Applied</p>
              <ul>
                {d.skills.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="page pager" aria-label="More work">
      {
        prev ? (
          <a href={`/work/${prev.id}/`} class="pager-link">
            <span class="eyebrow">Newer</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/work/${next.id}/`} class="pager-link pager-link--next">
            <span class="eyebrow">Older</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 8vh, 5rem) 0;
  }

  .hero h1 {
    font-size: var(--step-3);
    max-width: 22ch;
    margin: 0.85rem 0 1.1rem;
  }

  .hero-tagline {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: 1.75rem 2.5rem;
    margin-top: 3rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .metric-value {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
    margin: 0 0 0.35rem;
    letter-spacing: -0.02em;
  }

  .metric-label {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.35;
  }

  .body-grid {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 3.5rem;
    margin-top: 3.5rem;
    align-items: start;
  }

  /* Grid children default to min-width:auto, so a wide diagram inside .prose
     would stretch the column past the viewport instead of scrolling inside
     its own frame. */
  .body-grid > * {
    min-width: 0;
  }

  .facts {
    position: sticky;
    top: 6rem;
  }

  .facts dl {
    margin: 0;
    display: grid;
    gap: 1.1rem;
  }

  .fact dt,
  .fact-heading {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 0.25rem;
  }

  .fact dd {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text);
    margin: 0;
  }

  .fact-skills {
    margin-top: 1.75rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
  }

  .fact-skills ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .fact-skills li {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .pager-link {
    display: grid;
    gap: 0.4rem;
    text-decoration: none;
  }

  .pager-link--next {
    text-align: right;
  }

  .pager-title {
    font-family: var(--font-serif);
    font-size: var(--step-0);
    font-weight: 600;
    max-width: 22ch;
  }

  .pager-link--next .pager-title {
    justify-self: end;
  }

  .pager-link:hover .pager-title {
    color: var(--accent);
  }

  @media (max-width: 62rem) {
    .body-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .facts {
      position: static;
      max-width: var(--measure);
    }
    .facts dl {
      grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
      gap: 1.25rem 2rem;
    }
    .fact-skills {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-link--next {
      text-align: left;
    }
    .pager-link--next .pager-title {
      justify-self: start;
    }
  }
</style>
