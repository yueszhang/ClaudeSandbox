---
// Three states in one control: system (default) → light → dark → system.
// Starting from system means the site respects the reader's OS setting until
// they explicitly say otherwise.
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Change color theme"
  title="Change color theme"
>
  <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none"
    stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.6v2.2M12 19.2v2.2M4.3 4.3l1.6 1.6M18.1 18.1l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.3 19.7l1.6-1.6M18.1 5.9l1.6-1.6"></path>
  </svg>
  <span class="visually-hidden" data-theme-label>System theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--border);
  }
</style>

<script>
  type Mode = 'system' | 'light' | 'dark';
  const ORDER: Mode[] = ['system', 'light', 'dark'];

  const apply = (mode: Mode) => {
    const root = document.documentElement;
    if (mode === 'system') {
      delete root.dataset.theme;
      localStorage.removeItem('theme');
    } else {
      root.dataset.theme = mode;
      localStorage.setItem('theme', mode);
    }
    document.querySelectorAll<HTMLElement>('[data-theme-label]').forEach((el) => {
      el.textContent = `${mode[0].toUpperCase()}${mode.slice(1)} theme`;
    });
  };

  const stored = localStorage.getItem('theme');
  let current: Mode = stored === 'light' || stored === 'dark' ? stored : 'system';
  apply(current);

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      current = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
      apply(current);
    });
  });
</script>
