---
import Figure from './Figure.astro';
import MaturityModel from './diagrams/MaturityModel.astro';
import AiDeliveryLoop from './diagrams/AiDeliveryLoop.astro';
import BuildBuy from './diagrams/BuildBuy.astro';
import RequirementsSplit from './diagrams/RequirementsSplit.astro';

interface Props {
  name: string;
}
const { name } = Astro.props;

// Captions live here so a case study only has to name a diagram.
const captions: Record<string, string> = {
  maturity:
    'Four stages, with a gate between each. The gates make a team’s stage visible from outside rather than claimed, which is what stops the whole thing reporting green while nothing moves.',
  ailoop:
    'Where the tooling sat in the delivery lifecycle. The 1.5× landed in build throughput and in fix-and-reverify time.',
  buildbuy:
    'Build only where the capability is the differentiation. Everywhere else the market solution wins and building means paying maintenance forever.',
  requirements:
    'Splitting core from future-state is what turned 400 requirements into a negotiating position rather than documentation.',
};
---

{name === 'maturity' && <Figure caption={captions.maturity} wide><MaturityModel /></Figure>}
{name === 'ailoop' && <Figure caption={captions.ailoop} wide><AiDeliveryLoop /></Figure>}
{name === 'buildbuy' && <Figure caption={captions.buildbuy} wide><BuildBuy /></Figure>}
{name === 'requirements' && <Figure caption={captions.requirements} wide><RequirementsSplit /></Figure>}
